# Alpha Vantage API Configuration
# Get your free API key from: https://www.alphavantage.co/support/#api-key
VITE_ALPHA_VANTAGE_API_KEY=your_api_key_here

# API Configuration
VITE_API_BASE_URL=https://www.alphavantage.co/query

# Rate limiting settings (Alpha Vantage free tier has 5 calls/min, 500 calls/day)
VITE_API_CALLS_PER_MINUTE=5
VITE_API_CALLS_PER_DAY=500

# Cache settings (in milliseconds)
VITE_CACHE_DURATION=300000 # 5 minutes

# Development settings
VITE_USE_MOCK_DATA=false # Set to true for development without API key